<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Files and folders the user opens, saves or drops. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Reopening them next launch: session, folders, recents. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Remote images, and KaTeX and Mermaid from the CDN when not bundled. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- Pandoc, for export to Word, EPUB and the rest: where Homebrew and
	     MacPorts install it, read-only. Pandoc links Homebrew's libraries,
	     so the whole prefix is needed, not only its own files. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/opt/homebrew/</string>
		<string>/usr/local/</string>
		<string>/opt/local/</string>
	</array>
</dict>
</plist>
